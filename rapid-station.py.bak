                    nextStation = ALLOCATIONS()
                elif selNextStation == 1:
                    nextStation = BAY_DROPS()
                elif selNextStation == 2:
                    nextStation = PURCHASING()
                elif selNextStation == 3:
                    nextStation = RECEIVING()
                elif selNextStation == 4:
                    nextStation = CREATE_NEST()
                elif selNextStation == 5:
                    nextStation = NESTING()
                elif selNextStation == 6:
                    nextStation = HOLZMA()
                elif selNextStation == 7:
                    nextStation = EDGING()
                elif selNextStation == 8:
                    nextStation = HINGING()
                elif selNextStation == 9:
                    nextStation = REWORKS_QA()
                elif selNextStation == 10:
                    nextStation = REWORK_COMPLETE()
                elif selNextStation == 11:
                    nextStation = DISPATCH()
                else:
                    nextStation = RAPID_COMPLETE()
                # Now set it to the next station
                #rapidModel.moveRapid(partID, nextStation)
                rapidModel2.moveRapid(partID, nextStation)
                self.txtPartIDScanOut.SetValue('')
                #Update Grid immediately
                #self.updateGrid()
                self.updateOneCol(tblPart[0][11])
                self.updateOneCol(nextStation)
