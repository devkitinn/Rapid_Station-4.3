    def update(self, event):
        self.updateGrid()

    def grid_ChangePart(self, event):  # wxGlade: rapid.<event_handler>
        self.myCol = event.Col
        self.myRow = event.Row
        partID = self.gridJobList.GetCellValue(event.Row, event.Col)
        setWhite = (255,255,255)   # White background
        setColour = setWhite
        if partID != '':
            partIDonly = partID.split()[0]
            tblPart = rapidModel2.getPart(partIDonly)
            partMaterial =tblPart[0][6]
            self.lbl_PartID.SetLabel(partID)
            self.lbl_PartJob.SetLabel(tblPart[0][1])
            if tblPart[0][16] is not None:
                #self.lbl_PartInstallDate.SetLabel(tblPart[0][21].strftime("%d/%m/%y"))
                self.lbl_PartInstallDate.SetLabel(tblPart[0][17].strftime("%Y-%m-%d"))
            else:
                self.lbl_PartInstallDate.SetLabel('')
            self.lbl_PartWO.SetLabel(tblPart[0][2])
            self.lbl_PartName.SetLabel(tblPart[0][3])
            self.lbl_PartCabNo.SetLabel(tblPart[0][4])
            self.lbl_PartCabName.SetLabel(tblPart[0][5])
            self.lbl_PartMaterial.SetLabel(tblPart[0][6])
            self.lbl_PartLength.SetLabel(str(tblPart[0][7]))
            self.lbl_PartWidth.SetLabel(str(tblPart[0][8]))
            self.lbl_PartThick.SetLabel(str(tblPart[0][9]))
            self.lbl_PartEdge.SetLabel(str(tblPart[0][10]))
            if str(tblPart[0][17]) != "":
                self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][17]))
#            elif str(tblPart[0][18]) != "":
#                self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][18]))
#            elif str(tblPart[0][19]) != "":
#                self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][19]))
            else:
                self.lbl_PartEdgeMaterial.SetLabel('')
            self.lbl_PartLocation.SetLabel(self.getLocation(tblPart[0][11]))
            self.lbl_RecutTool.SetLabel(self.getRecutTool(tblPart[0][12]))
            #self.lbl_PartTime.SetLabel(str(tblPart[0][13]).strftime("%Y-%m-%d %H:%M:%S"))
            self.lbl_PartTime.SetLabel(str(tblPart[0][13]))
            self.lbl_PartBay.SetLabel(str(tblPart[0][14]))
            self.lbl_PartNote.SetLabel(str(tblPart[0][15]))
            if tblPart[0][12] == SAW():
                self.btn_toCreateNest.Disable()
                self.btn_toNesting.Disable()
                self.btn_toHolzma.Enable()
            elif tblPart[0][12] == CNC():
                self.btn_toCreateNest.Enable()
                self.btn_toNesting.Enable()
                self.btn_toHolzma.Disable()
            else:
                self.btn_toCreateNest.Enable()
                self.btn_toNesting.Enable()
                self.btn_toHolzma.Enable()
            partMaterial =tblPart[0][6]
            setColour = (255, 165, 0)
            self.txtPartID.SetValue(partIDonly)
            self.txtJob.SetValue(tblPart[0][1])
        else:
            partMaterial = ''

        self.gridJobList.SetDefaultCellBackgroundColour(setWhite)
        for col in range(self.gridJobList.GetNumberCols()):
            for row in range(self.gridJobList.GetNumberRows()):
                partID = self.gridJobList.GetCellValue(row, col)
                if partID != '':
                    partIDonly = partID.split()[0]
                    #tblPart = rapidModel.getPart(partIDonly)
                    #if partMaterial == tblPart[0][6]:
                    if partMaterial == self.rapidDict[partIDonly][5]:
                        self.gridJobList.SetCellBackgroundColour(row, col, setColour)
                    elif partIDonly.find("RW") >= 0 or partIDonly[1:2] == 'R' or partIDonly[2:3] == 'R':
                        self.gridJobList.SetCellBackgroundColour(row, col, (124, 185, 232))
                    elif partIDonly[:1] == 'R':
                        self.gridJobList.SetCellBackgroundColour(row, col, (124, 185, 232))
                    else:
                        self.gridJobList.SetCellBackgroundColour(row, col, setWhite)
                else:
                    self.gridJobList.SetCellBackgroundColour(row, col, setWhite)


        self.gridJobList.ForceRefresh()
        event.Skip()

    def btn_SendToAllocations(self, event):  # wxGlade: rapid.<event_handler>
        partID = self.gridJobList.GetCellValue(self.myRow, self.myCol)
        partIDonly = partID.split()[0]
        #rapidModel.moveRapid(partIDonly, ALLOCATIONS())
        rapidModel2.moveRapid(partIDonly, ALLOCATIONS())
