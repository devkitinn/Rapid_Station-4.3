    def updateGrid(self):
        print("Start Test")
        print(datetime.datetime.now())
        #Get new data
        cols = 0
        colDetail = []
        rows = 0

        if conf.config.get('VISIBLE STATIONS', 'allocations') == 'True':
            cnt = 0
            list_of_ids = []
            rapidParts = rapidModel2.getPartsWithRapids(ALLOCATIONS())
            for first, *rest in rapidParts:
                self.rapidDict[first] = rest
            for i in range(0, len(rapidParts)):
                cnt += 1
                if rapidParts[i][16] is None:
                    tim = "*"
                else:
                    tim = rapidParts[i][16].strftime("%d %b")
                list_of_ids.append(rapidParts[i][0] + ' [' + tim + ']')
            colDetail.append(list_of_ids)
            if len(colDetail[cols]) > rows:
                rows = len(colDetail[cols])
            cols += 1
