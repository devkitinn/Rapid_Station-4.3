        event.Skip()

    def btn_SendToBayDrops(self, event):  # wxGlade: rapid.<event_handler>
        partID = self.gridJobList.GetCellValue(self.myRow, self.myCol)
        partIDonly = partID.split()[0]
        dlg = SelectToolDialog()
        res = dlg.ShowModal()
        if res == wx.ID_OK:
            selection = dlg.rbox.GetSelection()
        dlg.Destroy()
        if selection == SAW() - 1:
            tool = SAW()
            self.btn_toCreateNest.Disable()
            self.btn_toNesting.Disable()
            self.btn_toHolzma.Enable()
        elif selection == CNC() - 1:
            tool = CNC()
            self.btn_toCreateNest.Enable()
            self.btn_toNesting.Enable()
            self.btn_toHolzma.Disable()
        else:
            tool = 0
        #rapidModel.setTool(partIDonly, tool)
        rapidModel2.setTool(partIDonly, tool)
        #rapidModel.moveRapid(partIDonly, BAY_DROPS())
        rapidModel2.moveRapid(partIDonly, BAY_DROPS())
        self.updateGrid()
        event.Skip()

