    def JobRapids(self, event):  # wxGlade: rapid.<event_handler>
        jobName = self.txtJob.GetValue()
        if jobName != '':
            dlg = rapidJob.jobFrame()
            # Now fill it with the original job from RAPID
            try:
                jobDate = rapidModel2.getJobInstallDate(jobName)[0][1]
            except:
                jobDate = ""

            tblParts = rapidModel2.getJobRapids(jobName)
            jobName = tblParts[0][12]
            # ID, ID, WorkOrder, PartName, CabNum, CabName, Material, FinalLength, FinalWidth, BandingLabelCode, Station, UN_Done

            countRows = dlg.grid_1.GetNumberRows()
            dlg.grid_1.DeleteRows(0, countRows)
            for i in range(0, len(tblParts)):
                tblParts[i] = list(tblParts[i])
                #if tblParts[i][11] == None:
                #    tblParts[i][11] = '0'
                #if tblParts[i][12] != 1:
                #    tblParts[i][11] = 'Not Scanned Yet'
                #else:
                #    tblParts[i][11] = self.getLocation(int(tblParts[i][11]))
                #del tblParts[i][12]     # Now remove the scanned status column
                dlg.grid_1.AppendRows(1)
                dlg.grid_1.SetCellValue(i,0, "R" + str(tblParts[i][0])) #ID
                dlg.grid_1.SetCellValue(i,1, str(tblParts[i][2]))       #Work Order
                dlg.grid_1.SetCellValue(i,2, str(tblParts[i][3]))       #Part Name
                dlg.grid_1.SetCellValue(i,3, str(tblParts[i][4]))       #Cab No
                dlg.grid_1.SetCellValue(i,4, str(tblParts[i][5]))       #Cab Name
                dlg.grid_1.SetCellValue(i,5, str(tblParts[i][6]))       #Material
                dlg.grid_1.SetCellValue(i,6, str(tblParts[i][7]))       #Length
                dlg.grid_1.SetCellValue(i,7, str(tblParts[i][8]))       #Width
                dlg.grid_1.SetCellValue(i,8, str(tblParts[i][9]))       #Thickness
                dlg.grid_1.SetCellValue(i,9, str(tblParts[i][10]))      #Edge

#                for j in range(1, len(tblParts[i])):
#                    dlg.grid_1[i][j] = str(tblParts[i][j])
#                       tblParts.insert(0, ["Barcode", "ID", "Part Name", "Cab\nNo", "Cab Name", "Material", "L", "W", "Edging", "Location"])
#                    tblParts[i][j] = printLib.Paragraph(str(tblParts[i][j]), printLib.tableStyle)

            dlg.grid_1.AutoSize()
            dlg.BestSize
            dlg.btnCancel.SetFocus()      #Set focus to cancel button
            dlg.txtJobName.SetValue(jobName)
            dlg.cbAddR.SetValue(True)
            dlg.ShowModal()
            dlg.Destroy()
            self.updateGrid()
        else:
            wx.MessageBox('Please enter a job.')
        event.Skip()

    def printWorkstationJobs(self, event):  # wxGlade: rapid.<event_handler>
        rapidLocationNumber = self.comboWorkstations.GetSelection()
        if rapidLocationNumber == 0:
            rapidLocationNumber = ALLOCATIONS()
        elif rapidLocationNumber == 1:
            rapidLocationNumber = BAY_DROPS()
        elif rapidLocationNumber == 2:
            rapidLocationNumber = PURCHASING()
        elif rapidLocationNumber == 3:
            rapidLocationNumber = RECEIVING()
        elif rapidLocationNumber == 4:
            rapidLocationNumber = CREATE_NEST()
        elif rapidLocationNumber == 5:
            rapidLocationNumber = NESTING()
        elif rapidLocationNumber == 6:
            rapidLocationNumber = HOLZMA()
        elif rapidLocationNumber == 7:
            rapidLocationNumber = EDGING()
        elif rapidLocationNumber == 8:
            rapidLocationNumber = HINGING()
        elif rapidLocationNumber == 9:
            rapidLocationNumber = REWORKS_QA()
        elif rapidLocationNumber == 10:
            rapidLocationNumber = REWORK_COMPLETE()
        elif rapidLocationNumber == 11:
            rapidLocationNumber = DISPATCH()
        else:
            rapidLocationNumber = RAPID_COMPLETE()
        rapidLocation = self.getLocation(rapidLocationNumber)
        printLib.resetPrinting(f"RAPID Parts for {rapidLocation}")
        im = printLib.Image("ki_logo.ico",width=30,height=30)
        im.hAlign = 'LEFT'
        para = printLib.Paragraph(f"RAPID Parts for {rapidLocation}", printLib.HeaderStyle)
        #tblData = [[im, para],]
        tblData = [[para],]
        #t = printLib.Table(tblData, colWidths=(40, None))
        t = printLib.Table(tblData, colWidths=(None))
        printLib.Elements.append(t)
        tblParts = rapidModel2.getLocationRapidParts(rapidLocationNumber)
        for i in range(0, len(tblParts)):
            tblParts[i] = list(tblParts[i])
            for j in range(1, len(tblParts[i])):
                tblParts[i][j] = printLib.Paragraph(str(tblParts[i][j]), printLib.tableStyle)
            tblParts[i][0] = printLib.code128.Code128(tblParts[i][0])

        tblParts.insert(0, ["Barcode", "Job", "ID", "Part Name", "Cab\nNo", "Cab Name", "Material", "L", "W", "Edging"])
        #printLib.printTable(tblParts, (None, 3 * cm, 3 * cm, None, cm, 3 * cm, None, 2 * cm, 2 * cm, 2 * cm))
        printLib.printTable(tblParts, (None, 3 * cm, 3 * cm, 3 * cm, None, 3 * cm, 3 * cm, 2 * cm, 2 * cm, 2 * cm))
        printLib.goPrintLandscape()
        event.Skip()

    def getLocation(self, locationID):
        if locationID == 0:
            locationText = "Check job"
        elif locationID == ALLOCATIONS():
            locationText = "Allocations"
        elif locationID == BAY_DROPS():
            locationText = "Push In"
        elif locationID == PURCHASING():
            locationText = "Purchasing"
        elif locationID == RECEIVING():
            locationText = "Waiting Receipt"
        elif locationID == CREATE_NEST():
            locationText = "Create Nest"
        elif locationID == NESTING():
            locationText = "Nesting"
        elif locationID == HOLZMA():
            locationText = "Holzma"
        elif locationID == EDGING():
            locationText = "Edging"
        elif locationID == HINGING():
            locationText = "Waiting for Edge Tape"
        elif locationID == REWORKS_QA():
            locationText = "Reworks QA"
        elif locationID == REWORK_COMPLETE():
            locationText = "Rework Complete"
        elif locationID == DISPATCH():
            locationText = "Dispatch"
        else:
            locationText = "Check Job"
        return locationText

    def getRecutTool(self, tool):
        if tool == SAW():
            toolText = "Saw"
        elif tool == CNC():
            toolText = "CNC"
        else:
            toolText = ""
        return toolText

    def getTimeDiff(self, then):
        now = datetime.datetime.now()
        if then is None:
            then = now
        time_diff = now - then
        d = time_diff.days
        h = divmod(time_diff.seconds, 3600)
        m = divmod(h[1], 60)
        if d < 0:
            d = 0
        return f' ({h[0] + d * 24}:{m[0]})'
# end of class rapid

# SelectDialogBox
class SelectToolDialog(wx.Dialog):
    def __init__(self):
        """Constructor"""
        wx.Dialog.__init__(self, None, title="Select which machine will cut this part")
        lblList = ['Saw', 'CNC']
        self.rbox = wx.RadioBox(self, label='Select', choices=lblList, majorDimension = 1, style = wx.RA_SPECIFY_ROWS)
        okBtn = wx.Button(self, wx.ID_OK)
        sizer = wx.BoxSizer(wx.VERTICAL)
        sizer.Add(self.rbox, 0, wx.ALL | wx.CENTER, 5)
        sizer.Add(okBtn, 0, wx.ALL | wx.CENTER, 5)
        self.SetSizer(sizer)
        self.SetSize((275, 150))

# SelectDialogBox
class SelectBayDialog(wx.Dialog):
    def __init__(self):
        """Constructor"""
        wx.Dialog.__init__(self, None, title="Select which bay to store this part")
        lblList = ['Bay 1', 'Bay 2', 'Bay 3', 'Bay 4', 'Bay 5']
        self.cbox = wx.ComboBox(self, choices=lblList,  style = wx.CB_READONLY)
        self.cbox.SetSelection(0)
        okBtn = wx.Button(self, wx.ID_OK)
        sizer = wx.BoxSizer(wx.VERTICAL)
        sizer.Add(self.cbox, 0, wx.ALL | wx.CENTER, 5)
        sizer.Add(okBtn, 0, wx.ALL | wx.CENTER, 5)
        self.SetSizer(sizer)
        self.SetSize((275, 150))


class MyApp(wx.App):
    def OnInit(self):
        self.frm_RAPIDMatrix = rapid(None, wx.ID_ANY, "")
        self.SetTopWindow(self.frm_RAPIDMatrix)
        self.frm_RAPIDMatrix.Show()
        return True

# end of class MyApp

if __name__ == "__main__":
    conf.get_conf()
    divs = ", ".join(conf.get_allowed_divisions())
    print(f"Version {VERSION()} - Divisions: {divs}")
    Station = MyApp(0)
    Station.MainLoop()
