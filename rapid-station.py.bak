                self.lbl_PartWO.SetLabel(tblPart[0][2])
                self.lbl_PartName.SetLabel(tblPart[0][3])
                self.lbl_PartCabNo.SetLabel(tblPart[0][4])
                self.lbl_PartCabName.SetLabel(tblPart[0][5])
                self.lbl_PartMaterial.SetLabel(tblPart[0][6])
                self.lbl_PartLength.SetLabel(str(tblPart[0][7]))
                self.lbl_PartWidth.SetLabel(str(tblPart[0][8]))
                self.lbl_PartThick.SetLabel(str(tblPart[0][9]))
                self.lbl_PartEdge.SetLabel(str(tblPart[0][10]))
                if str(tblPart[0][17]) != "":
                    self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][17]))
                elif str(tblPart[0][18]) != "":
                    self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][18]))
                elif str(tblPart[0][19]) != "":
                    self.lbl_PartEdgeMaterial.SetLabel(str(tblPart[0][19]))
                else:
