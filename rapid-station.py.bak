        if conf.config.get('VISIBLE STATIONS', 'reworkcomplete') == 'True':
            cnt = 0
            list_of_ids = []
            rapidParts = rapidModel2.getPartsWithRapids(REWORK_COMPLETE())
            for first, *rest in rapidParts:
                self.rapidDict[first] = rest
            for i in range(0, len(rapidParts)):
                cnt += 1
                if rapidParts[i][16] is None:
                    tim = "*"
                else:
                    tim = rapidParts[i][16].strftime("%d %b")
                list_of_ids.append(rapidParts[i][0] + ' [' + tim + ']')
            colDetail.append(list_of_ids)
            if len(colDetail[cols]) > rows:
                rows = len(colDetail[cols])
            cols += 1
        if conf.config.get('VISIBLE STATIONS', 'dispatch') == 'True':
            cnt = 0
            list_of_ids = []
            rapidParts = rapidModel2.getPartsWithRapids(DISPATCH())
            for first, *rest in rapidParts:
                self.rapidDict[first] = rest
            for i in range(0, len(rapidParts)):
                cnt += 1
                if rapidParts[i][16] is None:
                    tim = "*"
                else:
                    tim = rapidParts[i][16].strftime("%d %b")
                list_of_ids.append(rapidParts[i][0] + ' [' + tim + ']')
            colDetail.append(list_of_ids)
            if len(colDetail[cols]) > rows:
                rows = len(colDetail[cols])
            cols += 1

        #Remove all items from grid
        self.gridJobList.ClearGrid()
        # Fix grid rows to required amount
        cur_rows = self.gridJobList.GetNumberRows()
        if rows > cur_rows:
            # Append rows
            self.gridJobList.AppendRows(rows-cur_rows)
        if rows < cur_rows:
            # Delete rows
            self.gridJobList.DeleteRows(0, cur_rows - rows, True)

        # Now fix grid columns to required amount
        cur_cols = self.gridJobList.GetNumberCols()
        if cols > cur_cols:
            # Append cols
            self.gridJobList.AppendCols(cols-cur_cols)
        if cols < cur_cols:
            # Delete cols
            self.gridJobList.DeleteCols(0, cur_cols - cols, True)

        #rapidDict is dictionary with install date
        dateBeforeRed = datetime.datetime.now().date() + datetime.timedelta(days=2)
        for col in range(0, cols):
            for row in range(0, len(colDetail[col])):
                # print(colDetail[col][row].split(' ', 1))
                # print(self.rapidDict[colDetail[col][row].split(' ', 1)[0]])
                self.gridJobList.SetCellValue(row, col, colDetail[col][row])

                try:
                    if self.rapidDict[colDetail[col][row].split(' ', 1)[0]][15] is not None:
                        #print(dateBeforeRed.strftime("%d/%m/%y") + ' ' + self.rapidDict[colDetail[col][row].split(' ', 1)[0]][0][15].strftime("%d/%m/%y"))
                        diff = self.rapidDict[colDetail[col][row].split(' ', 1)[0]][15]
                    else:
                        print("No date")
                        diff = None

                    if diff is not None:
                        #dateOfJob = datetime.datetime.strptime(self.rapidDict[colDetail[col][row].split(' ', 1)[0]][0][15], '%Y-%m-%d').date()
                        dateOfJob = self.rapidDict[colDetail[col][row].split(' ', 1)[0]][15].date()
                        if dateOfJob < dateBeforeRed:
                        #if diff > 0:
                            self.gridJobList.SetCellBackgroundColour(row, col, (255, 0, 0))
                    # print(diff, col, row)
                except Exception as e:
                    print('Error with following job:')
                    print(self.rapidDict[colDetail[col][row].split(' ', 1)[0]])
                    print(colDetail[col][row])

            self.gridJobList.SetColLabelValue(col, colHdr[col])
            self.gridJobList.SetColSize(col, 120)

        curX, curY = self.sizer_3.GetSize()
        self.sizer_3.SetMinSize((80*cols, curY))
        self.Layout()

    def updateOneCol(self,col2update):
        #Get new data
        rows = 0
        if self.getLocation(col2update) in colHdr:
            cnt = 0
            list_of_ids = []
            rapidParts = rapidModel2.getPartsWithRapids(col2update)
            for first, *rest in rapidParts:
                self.rapidDict[first] = rest
            for i in range(0, len(rapidParts)):
                cnt += 1
                if rapidParts[i][16] is None:
                    tim = "*"
                else:
                    tim = rapidParts[i][16].strftime("%d %b")
                list_of_ids.append(rapidParts[i][0] + ' [' + tim + ']')
            if len(list_of_ids) > rows:
                rows = len(list_of_ids)

            # Fix grid rows to required amount
            cur_rows = self.gridJobList.GetNumberRows()
            if rows > cur_rows:
                # Append rows
                self.gridJobList.AppendRows(rows-cur_rows)
            #rapidDict is dictionary with install date
            dateBeforeRed = datetime.datetime.now().date() + datetime.timedelta(days=2)
            for row in range(0, cur_rows):
                self.gridJobList.SetCellValue(row, col2update - 1, "")
            for row in range(0, len(list_of_ids)):
                self.gridJobList.SetCellValue(row, col2update-1, list_of_ids[row])
                if self.rapidDict[list_of_ids[row].split(' ', 1)[0]][15] is not None:
                    diff = self.rapidDict[list_of_ids[row].split(' ', 1)[0]][15]
                else:
                    diff = None

                if diff is not None:
                    dateOfJob = self.rapidDict[list_of_ids[row].split(' ', 1)[0]][15].date()
                    if dateOfJob < dateBeforeRed:
                        self.gridJobList.SetCellBackgroundColour(row, col2update, (255, 0, 0))
            self.Layout()

    def getHeaders(self):
        if conf.config.get('VISIBLE STATIONS', 'allocations') == 'True':
            colHdr.append('Allocations')
        if conf.config.get('VISIBLE STATIONS', 'bay_drops') == 'True':
            colHdr.append('Push In')
        if conf.config.get('VISIBLE STATIONS', 'purchasing') == 'True':
            colHdr.append('Purchasing')
        if conf.config.get('VISIBLE STATIONS', 'receiving') == 'True':
            colHdr.append('Receiving')
        if conf.config.get('VISIBLE STATIONS', 'create_nest') == 'True':
            colHdr.append('Create Nest')
        if conf.config.get('VISIBLE STATIONS', 'nesting') == 'True':
            colHdr.append('Nesting')
        if conf.config.get('VISIBLE STATIONS', 'holzma') == 'True':
            colHdr.append('Holzma')
        if conf.config.get('VISIBLE STATIONS', 'edging') == 'True':
            colHdr.append('Edging')
        if conf.config.get('VISIBLE STATIONS', 'hinging') == 'True':
            colHdr.append('Waiting for Edge Tape')
        if conf.config.get('VISIBLE STATIONS', 'reworksqa') == 'True':
            colHdr.append('Reworks QA')
        if conf.config.get('VISIBLE STATIONS', 'ReworkComplete') == 'True':
            colHdr.append('Rework Complete')
        if conf.config.get('VISIBLE STATIONS', 'dispatch') == 'True':
            colHdr.append('Dispatch Bay')

    def scanPartOut(self, event):  # wxGlade: rapid.<event_handler>
        partID = self.txtPartIDScanOut.GetValue()
        tblPart = rapidModel2.getPart(partID)
        if len(tblPart) > 0:
            if tblPart[0][0] == partID:
                self.lbl_PartID.SetLabel(partID)
                self.lbl_PartJob.SetLabel(tblPart[0][1])
                self.lbl_PartWO.SetLabel(tblPart[0][2])
                self.lbl_PartName.SetLabel(tblPart[0][3])
                self.lbl_PartCabNo.SetLabel(tblPart[0][4])
                self.lbl_PartCabName.SetLabel(tblPart[0][5])
                self.lbl_PartMaterial.SetLabel(tblPart[0][6])
