                self.lbl_PartLocation.SetLabel(self.getLocation(tblPart[0][11]))
                self.lbl_RecutTool.SetLabel(self.getRecutTool(tblPart[0][12]))
                self.lbl_PartTime.SetLabel(str(tblPart[0][13]))
                self.lbl_PartBay.SetLabel(str(tblPart[0][14]))
                self.lbl_PartNote.SetLabel(str(tblPart[0][15]))

                selNextStation = self.comboDestinationWorkstation.GetSelection()
